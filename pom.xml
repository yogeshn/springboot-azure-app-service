<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">  
  <modelVersion>4.0.0</modelVersion>  
  <parent> 
    <groupId>org.springframework.boot</groupId>  
    <artifactId>spring-boot-starter-parent</artifactId>  
    <version>2.1.4.RELEASE</version>  
    <relativePath/>  
    <!-- lookup parent from repository --> 
  </parent>  
  <groupId>com.kalyan</groupId>  
  <artifactId>springboot-azure-app-service</artifactId>  
  <version>0.0.1-SNAPSHOT</version>  
  <name>springboot-azure-app-service</name>  
  <description>Spring Boot Hello World On Azure</description>  
  <properties> 
    <!-- Build, test, and deploy with JDK 21. Spring Boot 2.1.4.RELEASE is not officially certified on JDK 21, so monitor runtime behaviors closely. -->
    <java.version>21</java.version>
    <!-- Spring Framework 5.1 cannot yet emit Java 21 bytecode. Compile artifacts to Java 11 for compatibility while still running them on JDK 21. -->
    <bytecode.target.version>11</bytecode.target.version>
  </properties>  
  <dependencies> 
    <dependency> 
      <groupId>org.springframework.boot</groupId>  
      <artifactId>spring-boot-starter-web</artifactId> 
    </dependency>  
    <dependency> 
      <groupId>org.springframework.boot</groupId>  
      <artifactId>spring-boot-starter-thymeleaf</artifactId> 
    </dependency>  
    <dependency> 
      <groupId>org.springframework.boot</groupId>  
      <artifactId>spring-boot-starter-test</artifactId>  
      <scope>test</scope> 
    </dependency> 
  </dependencies>  
  <build> 
    <plugins> 
      <plugin> 
        <groupId>org.springframework.boot</groupId>  
        <artifactId>spring-boot-maven-plugin</artifactId> 
      </plugin>  
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <!-- Spring Boot 2.1.4.RELEASE defaults to Java 8. Explicit compiler settings are required for JDK 21 builds. -->
        <configuration>
          <release>11</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <!-- JDK 21 requires a modern Surefire runtime; this override supersedes the older version inherited from Spring Boot 2.1.4.RELEASE. -->
        <configuration>
          <useSystemClassLoader>true</useSystemClassLoader>
        </configuration>
      </plugin>
      <plugin> 
        <groupId>com.microsoft.azure</groupId>  
        <artifactId>azure-webapp-maven-plugin</artifactId>  
        <version>1.14.0</version>  
        <configuration>
          <schemaVersion>v2</schemaVersion>
          <subscriptionId>010799ed-43ef-424e-97c9-41e2b17dbd38</subscriptionId>
          <resourceGroup>kalyan-resource-group</resourceGroup>
          <appName>kalyan-springboot-azure-app-service</appName>
          <pricingTier>F1</pricingTier>
          <region>westeurope</region>
          <appSettings>
          	<property>
          		<name>JAVA_OPTS</name>
          		<value>-Dserver.port=80</value>
          	</property>
          </appSettings>
          <runtime>
            <os>Linux</os>
            <!-- Java 21 is required. Configure the Azure App Service runtime to use a Java 21 stack (e.g., Java 21/Java SE) via the Azure Portal or IaC templates. -->
            <javaVersion>Java 21</javaVersion>
            <webContainer>Java SE</webContainer>
          </runtime>
          <deployment>
            <resources>
              <resource>
                <directory>${project.basedir}/target</directory>
                <includes>
                  <include>*.jar</include>
                </includes>
              </resource>
            </resources>
          </deployment>
        </configuration>
      </plugin> 
    </plugins> 
  </build> 
</project>
